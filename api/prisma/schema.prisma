// 1. BLOK GENERATOR
generator client {
  provider = "prisma-client-js"
}

// 2. BLOK DATASOURCE
datasource db {
  provider = "postgresql" 
}

// 3. MODEL ANDA
model Room {
  id          Int      @id @default(autoincrement())
  roomNumber  String   @unique
  roomType    String
  price       Float
  isAvailable Boolean  @default(true)
  capacity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}